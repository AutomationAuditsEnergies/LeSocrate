((* if part.module_content *))
\textit{\small ((( part.module_content | latex_escape )))}
\vspace{0.8em}
((* endif *))

((( part.body | latex_escape_paragraphs )))

\newpage
((* endfor *))

% ─────────── Transition finale ───────────
((* if day_transition *))
\section*{Transition vers la prochaine séance}
\small\color{mutedgray}
((( day_transition | latex_escape )))
\normalsize\color{black}
((* endif *))

