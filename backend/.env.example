SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# N'activer que si la base métier elle-même est Supabase. Laisser à 0 quand
# Supabase sert uniquement à l'auth et DATABASE_URL pointe vers Azure Postgres.
SUPABASE_DATABASE_REST_FALLBACK=0

# Super-admin historique : générer un hash Werkzeug, jamais de mot de passe en
# dur. Exemple: python -c "from getpass import getpass; from werkzeug.security import generate_password_hash; print(generate_password_hash(getpass()))"
INTERNAL_ADMIN_PASSWORD_HASH=
SECRET_KEY=replace-with-at-least-32-random-bytes
AUTH_TOKEN_MAX_AGE_SECONDS=43200
# Secret distinct utilisé par Azure Logic Apps pour POST /deconnexion-auto-tous
# via le header X-Internal-Secret. Un administrateur connecté est aussi accepté.
AUTO_LOGOUT_WEBHOOK_SECRET=

# Base Postgres cible. Pour Supabase, copier l'URI "Connection string"
# du projet. Pour Azure App Service (backend persistant), préférer le pooler
# Supavisor en mode Session (:5432). Le mode Transaction (:6543) reste pris en
# charge avec les prepared statements désactivés côté psycopg.
# Ne jamais committer la vraie valeur.
# Valeurs possibles: sqlite, hybrid, postgres.
# Phase actuelle recommandee en staging: hybrid.
DATABASE_BACKEND=sqlite
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=require
PIPELINE_DATABASE_BACKEND=sqlite
PIPELINE_POSTGRES_MIRROR=0

# Pool applicatif borné : évite une connexion Supabase par checkpoint quand
# plusieurs journées sont générées en parallèle.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=12
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_POOL_MAX_LIFETIME_SECONDS=1800
POSTGRES_POOL_MAX_IDLE_SECONDS=300
POSTGRES_POOL_RECONNECT_TIMEOUT_SECONDS=60
POSTGRES_CONNECT_TIMEOUT_SECONDS=20
POSTGRES_TIMEZONE=Europe/Paris
# Ne l'activer que pour contourner un réseau sans IPv6. Le pinning IP désactive
# le failover DNS transparent des offres PostgreSQL managées.
POSTGRES_FORCE_IPV4=0

# File durable des pipelines. `database` ne requiert aucune infra et convient
# au développement local. En production, `service_bus` conserve Postgres comme
# source de vérité et utilise Azure Service Bus comme notifier/load-leveler.
PIPELINE_QUEUE_BACKEND=database
PIPELINE_EXECUTION_MODE=inline
# Mettre à 1 si aucun worker dédié n'est encore déployé. En production à forte
# charge, utiliser `python -m workers.pipeline_worker` sur un service séparé.
PIPELINE_EMBEDDED_WORKER=0
PIPELINE_WORK_MAX_ATTEMPTS=5
PIPELINE_WORK_LEASE_SECONDS=300
PIPELINE_WORK_HEARTBEAT_SECONDS=60
PIPELINE_WORKER_POLL_SECONDS=1
# Readiness : heartbeat local périmé et travail actionnable sans lease active.
PIPELINE_WORKER_READY_STALE_SECONDS=180
PIPELINE_READY_QUEUE_STALL_SECONDS=600
PIPELINE_OUTBOX_BATCH_SIZE=20

# Service Bus optionnel. Sur App Service, préférer AZURE_SERVICE_BUS_NAMESPACE
# + identité managée (rôles Data Sender/Receiver) plutôt qu'une clé SAS.
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_CONNECTION_STRING=
PIPELINE_SERVICE_BUS_QUEUE=formation-pipeline
AZURE_SERVICE_BUS_WEBSOCKETS=0
PIPELINE_SERVICE_BUS_LOCK_RENEWAL_SECONDS=21600

# Artefacts lourds/diagnostics : Azure Blob, jamais Postgres ni disque local.
AZURE_TTS_STORAGE_CONNECTION_STRING=
AZURE_TTS_DOCUMENT_CONTAINER=documenttts
AZURE_TTS_AUDIO_CONTAINER=audiostts
# Container privé dédié aux JSON de diagnostic/artefacts de pipeline.
AZURE_PIPELINE_ARTIFACT_CONTAINER=pipeline-artifacts
PIPELINE_ARTIFACTS_REQUIRED=0
PIPELINE_BLOB_MAX_ATTEMPTS=3
# Cache court du véritable appel Azure effectué par /readyz.
PIPELINE_READY_BLOB_CACHE_SECONDS=60

# Lease de revendication des emails de rappel. Après un crash avant envoi, le
# rappel redevient traitable au lieu d'être marqué envoyé à tort.
COURSE_REMINDER_CLAIM_LEASE_SECONDS=900

# À désactiver quand toutes les promos utilisent Supabase Auth.
STUDENT_AUTH_LEGACY_FALLBACK=1

# Concurrence bornée par job. Le débit SaaS se scale avec les workers de file,
# pas avec 52 journées × plusieurs cours simultanés dans un seul process.
FORMATION_CONTENT_DAY_WORKERS=3
FORMATION_CONTENT_DAY_WORKERS_MAX=8

# Le listing HR des plateformes reste read-only par défaut pour ne pas attendre
# les verrous SQLite pendant les pipelines. Utiliser /api/hr/platforms?repair=1
# pour lancer la réparation lazy manuellement.
HR_DASHBOARD_REPAIR_ON_LOAD=false
