{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/static/*", "*.js", "*.css", "*.png", "*.jpg", "*.ico", "*.svg", "*.woff", "*.woff2", "*.otf", "*.ttf"]
  },
  "mimeTypes": {
    ".html": "text/html; charset=utf-8",
    ".js": "application/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".woff": "font/woff",
    ".woff2": "font/woff2",
    ".otf": "font/otf",
    ".ttf": "font/ttf"
  },
  "globalHeaders": {
    "Access-Control-Allow-Origin": "*"
  }
}
